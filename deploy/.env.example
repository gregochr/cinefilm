# Copy to ~/cinefilm/.env on dockermacmini (chmod 600). Never commit the real file. See docs/engineering/operations.md.

# The one sign-in password. Long and random (openssl rand -base64 24). The prod profile has no default.
CINEFILM_PASSWORD=

# Postgres (the cinefilm-db container). Generate the password with: openssl rand -hex 24
CINEFILM_DB_USER=cinefilm
CINEFILM_DB_PASSWORD=

# TMDB read access token (product phase 2; leave empty until then).
TMDB_READ_TOKEN=

# OMDb API key for IMDb and Rotten Tomatoes ratings (https://www.omdbapi.com/apikey.aspx, free tier 1,000 requests a
# day; CineFilm stops at 900). Leave blank to switch ratings off.
OMDB_API_KEY=

# Plex import (docs/engineering/plex-import-plan.md). Leave blank to switch the import off. The importer only
# GETs from PLEX_URL with PLEX_TOKEN in a header. PLEX_PATH_PREFIX is where Plex sees the library.
PLEX_URL=
PLEX_TOKEN=
PLEX_PATH_PREFIX=/Volumes/Media Library/Movies/
